# ─── Supabase (Project Settings → API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# New-style key (sb_publishable_…). Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-only secret key (sb_secret_… or legacy service_role). Used ONLY by /api/cron/* — never expose.
SUPABASE_SECRET_KEY=

# Public URL of this app (used in e-mails / LINE messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── E-mail notifications via Resend (optional — logged to console if empty) ─
RESEND_API_KEY=
EMAIL_FROM="ระบบจองห้อง อาคาร 3 <noreply@your-domain.com>"

# ─── LINE Messaging API (optional) ───────────────────────────────────────────
# LINE Notify was shut down on 31 Mar 2025 → use a LINE Official Account + Messaging API.
LINE_CHANNEL_ACCESS_TOKEN=
# userId / groupId of the staff LINE group that receives new-request & reminder messages
LINE_STAFF_TARGET_ID=

# ─── Cron (Vercel Cron or pg_cron + pg_net) ──────────────────────────────────
CRON_SECRET=change-me-to-a-long-random-string
